<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/unlockInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Базовые смайлы: 3 | Новые: 0 из 21"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/unlockAllButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🔓 РАЗБЛОКИРОВАТЬ ВСЕ СМАЙЛЫ (21 шт.)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/emojiRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:nestedScrollingEnabled="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="🔒 Нажмите на кнопку выше, посмотрите видео и разблокируйте все 21 смайлов!"
        android:textSize="11sp"
        android:textColor="#888888"
        android:gravity="center" />

</LinearLayout>