<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingBottom="24dp"
    android:background="?attr/colorSurface">

    <!-- ДОБАВЛЯЕМ ЗАГОЛОВОК В XML -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выберите смайл"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/quickEmojiRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:nestedScrollingEnabled="true"
        android:layout_marginBottom="12dp"
        android:scrollbars="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/quickUnlockAllButton"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="Разблокировать все смайлы&#10;после рекламного ролика"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:visibility="gone"
        app:backgroundTint="@color/dialog_control_fill"
        app:strokeColor="@color/dialog_control_border"
        app:strokeWidth="1dp"
        app:cornerRadius="18dp" />

</LinearLayout>