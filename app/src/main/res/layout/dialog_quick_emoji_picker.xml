<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingBottom="24dp"
    android:background="?attr/colorSurface">

    <!-- ДОБАВЛЯЕМ ЗАГОЛОВОК В XML -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выберите смайл"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/quickEmojiRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:nestedScrollingEnabled="true"
        android:layout_marginBottom="12dp"
        android:scrollbars="vertical" />

    <Button
        android:id="@+id/quickUnlockAllButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🔓 РАЗБЛОКИРОВАТЬ ВСЕ СМАЙЛЫ"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/quickUnlockHintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Нажмите на кнопку, посмотрите видео и получите все смайлы!"
        android:textSize="11sp"
        android:textColor="#888888"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

</LinearLayout>